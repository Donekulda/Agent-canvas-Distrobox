# Agent Canvas distrobox – configuration.
# Copy to .env (scripts/setup.sh does this and generates the keys). .env is gitignored and chmod 600.

# Distrobox container name and image (keep the Fedora release close to the host).
BOX_NAME=agent-canvas
BOX_IMAGE=registry.fedoraproject.org/fedora-toolbox:44

# The ONLY host address the UI is published on. Must exist on a host interface.
# 127.0.0.1 = local UI only; a LAN IP (e.g. 192.168.200.48) exposes it to the network.
BIND_IP=127.0.0.1
PORT=8000

# Separate home for the box (the host $HOME is not mounted).
BOX_HOME=$HOME/.local/share/distrobox-homes/agent-canvas

# Mounted into the box as /projects – the only host project folder the local agent sees.
PROJECTS_DIR=$HOME/agent-projects

# npm version of @openhands/agent-canvas installed inside the box.
AGENT_CANVAS_VERSION=1.16.0

# full          = UI + local agent-server + automation (all inside the box)
# frontend-only = UI only, for connecting to remote backends
MODE=full

# Language of ./menu.sh: en | cs. Empty = follow the system locale ($LANG). The menu sets it.
MENU_LANG=

# Secrets – generated by scripts/setup.sh (openssl rand -hex 32). Never commit.
# LOCAL_BACKEND_API_KEY is what you paste into the UI (public mode).
LOCAL_BACKEND_API_KEY=
OH_SECRET_KEY=
